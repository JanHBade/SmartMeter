

sudo sysctl -w net.ipv4.ip_forward=1

echo "net.ipv4.ip_forward=1" | sudo tee -a /etc/sysctl.conf
sudo sysctl -p

sudo nft add table nat
sudo nft 'add chain nat prerouting { type nat hook prerouting priority 0 ; }'
sudo nft 'add chain nat postrouting { type nat hook postrouting priority 100 ; }'
sudo nft add rule nat prerouting iifname "wlan0" tcp dport 443 dnat to 192.168.1.200:443
sudo nft add rule nat postrouting oifname "eth0" masquerade


sudo nft list ruleset > /etc/nftables.conf
sudo systemctl enable --now nftables

Dann kann man von beliebigen PCs im Netzwerk des Pi, den Smartmeter ansprechen.
